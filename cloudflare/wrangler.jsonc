{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nd-website",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nd-university-demo",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true }
}
